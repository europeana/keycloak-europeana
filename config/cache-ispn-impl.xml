<?xml version="1.0" encoding="UTF-8"?>
<infinispan
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:infinispan:config:16.0 https://infinispan.org/schemas/infinispan-config-16.0.xsd"
        xmlns="urn:infinispan:config:16.0">

  <cache-container name="keycloak">
    <transport lock-timeout="60000"/>

    <distributed-cache name="sessionTrackerCache"
                       mode="SYNC"
                       owners="2"
                       statistics="true">
      <locking isolation="READ_COMMITTED"/>
      <expiration lifespan="-1" max-idle="-1"/>
      <state-transfer enabled="true" timeout="60000"/>
    </distributed-cache>

  </cache-container>
</infinispan>
